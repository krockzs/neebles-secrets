[Unit]
Description=NEEBLES Secrets independent user vault daemon
After=basic.target
ConditionPathExists=/opt/neebles/modules/neebles-secrets/manifest.json

[Service]
Type=simple
ExecStart=/opt/neebles/modules/neebles-secrets/runtime/neebles-secrets --serve
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
